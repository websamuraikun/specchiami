{
  "id": "services",
  "type": "SharedSlice",
  "name": "Services",
  "description": "Services grid with icon, name, and description per card",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Grid of service cards",
      "primary": {
        "eyebrow": {
          "type": "Text",
          "config": { "label": "Eyebrow", "placeholder": "I nostri servizi" }
        },
        "heading": {
          "type": "StructuredText",
          "config": {
            "label": "Heading",
            "single": "heading2",
            "placeholder": "Cosa offriamo"
          }
        },
        "description": {
          "type": "StructuredText",
          "config": {
            "label": "Description",
            "multi": "paragraph,strong,em",
            "placeholder": "Breve descrizione della sezione..."
          }
        }
      },
      "items": {
        "icon": {
          "type": "Image",
          "config": {
            "label": "Icon",
            "constraint": { "width": 80, "height": 80 },
            "thumbnails": []
          }
        },
        "service_name": {
          "type": "Text",
          "config": { "label": "Service Name", "placeholder": "Nome servizio" }
        },
        "description": {
          "type": "StructuredText",
          "config": {
            "label": "Description",
            "multi": "paragraph,strong,em",
            "placeholder": "Descrizione del servizio..."
          }
        }
      },
      "imageUrl": "https://images.prismic.io/slice-machine/621a5ec4-0387-4bc5-9860-2dd46cbc07cd_default_ss.png?auto=compress,format"
    }
  ]
}
